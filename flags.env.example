# Force flags for a local ETL run.
#
#   set -a; . ./flags.env; set +a
#   quarto render etl.qmd
#
# Each script reads its own FORCE_<SCRIPT> variable. A variable that is unset,
# empty, or explicitly falsey ('0', 'false', 'off', 'no') does not force, so a
# flag can be switched off in place rather than deleted.
#
# DO NOT SET THESE IN POSIT CONNECT'S VARS PANE. A flag left on there forces
# every nightly run indefinitely; FORCE_SEC_POC_CLASSIFIER alone would
# reclassify every trial each night. Any flag in effect is named in the ETL
# report email so a forgotten one is visible the next morning.

# FORCE_ALL=1   # shortcut: forces every step, overriding the individual flags

# rebuild even when the NCIt version is unchanged
FORCE_REFRESH_NCIT_PG=1

# run even when an active NCIt version already exists
FORCE_NLP_TOKENIZER=1

# NO EFFECT -- this step has no skip path, it always runs
FORCE_API_ETL_V2=1

# NO EFFECT -- this step has no skip path, it always runs
FORCE_GET_ASSOCIATIONS=1

# tokenize every trial, not only changed ones
FORCE_SEC_POC_TOKENIZER=1

# clears classification_date -> reclassifies every trial
FORCE_SEC_POC_CLASSIFIER=1

# clears generated_date -> regenerates every expression
FORCE_SEC_POC_EXPRESSION_GENERATOR=1
